{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-mesh.local/schemas/coordination/20260814.1/event.schema.json",
  "title": "Dev Mesh coordination event",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "event",
    "at",
    "protocol",
    "protocol_version",
    "authority_effect",
    "transaction_id"
  ],
  "properties": {
    "schema": {"const": 2},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "event": {
      "enum": [
        "agent-joined",
        "agent-left",
        "run-authority-recovered",
        "audit-correction",
        "claim-created",
        "claim-activated",
        "claim-baseline-accepted",
        "claim-baseline-required",
        "claim-completed",
        "claim-paused",
        "claim-released",
        "claim-requested",
        "claim-resumed",
        "claim-updated",
        "cleanup-completed",
        "cleanup-authorized",
        "cleanup-needs-attention",
        "contention-cancelled",
        "contention-completed",
        "contention-coordinator-acquired",
        "contention-coordinator-renewed",
        "contention-decision-proposed",
        "contention-decision-responded",
        "contention-opened",
        "direct-commit-completed",
        "direct-commit-started",
        "handoff-accepted",
        "handoff-offered",
        "handoff-rejected",
        "handoff-withdrawn",
        "message-acknowledged",
        "message-sent",
        "transaction-aborted",
        "transaction-conflicted",
        "transaction-created",
        "transaction-handed-off",
        "transaction-prepared",
        "transaction-published",
        "transaction-refreshed",
        "transaction-validated",
        "work-resumed",
        "work-suspended"
      ]
    },
    "at": {"type": "string", "format": "date-time"},
    "protocol": {"const": "dev-mesh.coordination"},
    "protocol_version": {"const": "20260814.1"},
    "authority_effect": {
      "enum": ["none", "grant", "retain", "transfer", "release", "terminal"]
    },
    "transaction_id": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
